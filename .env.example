# ==============================================================================
# RAG Knowledge Base Catalog Service (rag-kb-catalog-service)
# Environment Configuration Template (.env.example)
#
# Copy this file to '.env' for local development or customize per deployment:
#   cp .env.example .env
#
# Non-negotiable security invariant: Never commit actual secret values or .env
# to version control. Keep all credentials masked in logs and configuration stores.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime Environment & Observability
# ------------------------------------------------------------------------------
# Deployment environment: 'development', 'staging', 'production', or 'test'.
ENVIRONMENT=development

# Structured logging level: 'debug', 'info', 'warn', or 'error'.
# In production, 'info' is recommended; 'debug' may emit verbose request tracing.
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. Service Networking & Transport Ports
# ------------------------------------------------------------------------------
# HTTP REST API & OpenAPI 3.1 Documentation endpoint listener (Swagger UI & ReDoc).
# Accepts host:port or :port (e.g., ':8080' or '0.0.0.0:8080').
HTTP_ADDR=:8080
# Alternatively specify port number only:
# HTTP_PORT=8080

# High-performance gRPC HTTP/2 server endpoint listener.
GRPC_ADDR=:50051
# Alternatively specify port number only:
# GRPC_PORT=50051

# Dedicated internal Prometheus metrics scrape listener (/metrics).
# Kept isolated from public HTTP routes for security and zero external telemetry exposure.
METRICS_ADDR=:9090
# Alternatively specify port number only:
# METRICS_PORT=9090

# ------------------------------------------------------------------------------
# 3. Security & Authentication (JWT HMAC)
# ------------------------------------------------------------------------------
# Symmetric HMAC secret key used to verify caller Bearer JWT tokens.
# REQUIRED: Startup will fail if this is empty.
# In production, must be a cryptographically random string of at least 32 bytes (256 bits).
# Example generation: openssl rand -base64 32
JWT_HMAC_SECRET="change-me-to-a-secure-random-at-least-32-byte-secret-key"

# ------------------------------------------------------------------------------
# 4. PostgreSQL 16 Persistence & PgBouncer Connection Pool (ADR-004, ADR-005)
# ------------------------------------------------------------------------------
# Primary database connection string (DSN).
# When DATABASE_URL is set, it takes precedence over the modular POSTGRES_* variables below.
# If DATABASE_URL and POSTGRES_HOST are both empty, the service falls back to in-memory catalog persistence (standalone mode).
DATABASE_URL="postgres://rag_catalog_user:change-me-postgres-password@localhost:5432/rag_catalog?sslmode=disable"

# Modular PostgreSQL parameters (used if DATABASE_URL is not set directly):
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_catalog
POSTGRES_USER=rag_catalog_user
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_SSLMODE=disable

# PgBouncer-compatible connection pool tuning parameters (pgxpool):
# MaxConns: Maximum concurrent database connections (default: 25)
POSTGRES_MAX_CONNS=25
# MinConns: Minimum idle database connections maintained (default: 5)
POSTGRES_MIN_CONNS=5
# MaxConnLifetime: Maximum total connection duration before recycling (default: 30m)
POSTGRES_MAX_CONN_LIFETIME=30m
# MaxConnIdleTime: Maximum idle connection duration before closing (default: 5m)
POSTGRES_MAX_CONN_IDLE_TIME=5m

# ------------------------------------------------------------------------------
# 5. Redis 7.2 Cluster Distributed Versioned Cache (ADR-003)
# ------------------------------------------------------------------------------
# Comma-separated list of Redis Cluster node addresses for active configuration caching.
# If empty, the service falls back to thread-safe in-memory caching.
REDIS_CLUSTER_ADDRS="localhost:7000,localhost:7001,localhost:7002"

# Authentication password for Redis Cluster (leave empty if AUTH is not required in dev).
REDIS_PASSWORD=""

# ------------------------------------------------------------------------------
# 6. Temporal Distributed Ingestion & Migration Orchestration (ADR-002)
# ------------------------------------------------------------------------------
# Target host:port for Temporal frontend service (used to trigger Blue-Green backfill DAGs).
# If empty, a fail-closed no-op trigger is used (local standalone mode).
TEMPORAL_HOST_PORT="localhost:7233"

# Temporal namespace for migration workflows.
TEMPORAL_NAMESPACE="rag-ingestion"

# Temporal task queue for backfill ingestion activities.
TEMPORAL_TASK_QUEUE="rag-ingestion-backfill"

